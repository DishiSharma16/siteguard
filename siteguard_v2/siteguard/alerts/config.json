    "objects_keys": ["objects", "detections"],
    "class_keys": ["class", "label", "obj_label"],
    "id_keys": ["track_id", "tracking_id", "object_id", "id"],
    "conf_keys": ["confidence", "conf", "score"],
    "bbox_key": "bbox",
    "bbox_format": "xyxy"
  },
  "incident_log": "../evidence/incident_log.jsonl"
}
