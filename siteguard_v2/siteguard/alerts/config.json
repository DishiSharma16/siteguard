{
  "mqtt": {"host": "localhost", "port": 1883, "topic": "siteguard/alerts"},
  "frame": {"width": 1280, "height": 720},
  "zone_id": "hazard_zone_1",
  "zone_polygon_norm": [[0.55, 0.40], [0.95, 0.40], [0.95, 0.95], [0.55, 0.95]],
